<Window x:Class="RestaurantManager.Views.KitchenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кухня — Замовлення" Height="450" Width="800"
        WindowStartupLocation="CenterScreen" Background="#1E1E2E">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Кухня: активні страви до приготування" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Foreground="White"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="↻ Оновити" Click="BtnRefresh_Click" 
                        Padding="12,6" Margin="0,0,8,0" Background="#313244" Foreground="White" BorderThickness="0"/>

                <Button Content="← Назад до залу" Click="BtnBackToMain_Click" 
                        Padding="12,6" Background="#313244" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="#262738" Padding="10">
            <ListBox x:Name="LvKitchenItems" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1E1E2E" Padding="12" Margin="0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding TableId, StringFormat=Стіл №{0}}" 
                                           Foreground="#89B4FA" FontWeight="Bold" VerticalAlignment="Center" FontSize="14"/>

                                <TextBlock Grid.Column="1" Text="{Binding DishName}" 
                                           Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="15"/>

                                <TextBlock Grid.Column="2" Text="{Binding Quantity, StringFormat={}{0} шт.}" 
                                           Foreground="#A6ADC8" VerticalAlignment="Center" FontSize="14"/>

                                <TextBlock Grid.Column="3" Text="{Binding StatusDisplay}" 
                                           Foreground="#F9E2AF" FontWeight="Bold" VerticalAlignment="Center" FontSize="14"/>

                                <Button Grid.Column="4" Content="Готово" Click="BtnReady_Click"
                                        Tag="{Binding}" Padding="10,6" Background="#313244" Foreground="#A6E3A1" BorderThickness="0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</Window>
