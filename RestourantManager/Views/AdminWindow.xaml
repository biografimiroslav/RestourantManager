<Window x:Class="RestaurantManager.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RestourantManager.Views"
        mc:Ignorable="d"
        Title="Панель адміністратора — Меню" Height="450" Width="800"
        WindowStartupLocation="CenterScreen" Background="#1E1E2E">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <DockPanel Grid.Row="0" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Керування меню ресторану" FontSize="20" FontWeight="Bold" Foreground="White"/>
            </StackPanel>
        </DockPanel>

        <!-- Основна зона: Таблиця страв у стилі карток/панелей -->
        <Border Grid.Row="1" Background="#262738" Padding="10" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Список страв (двічі клікніть по комірці для редагування назви, категорії чи ціни)" 
                           FontSize="13" Foreground="#A6ADC8" Margin="0,0,0,10"/>

                <!-- DataGrid -->
                <DataGrid x:Name="DishesGrid" Grid.Row="1" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          CellEditEnding="DishesGrid_CellEditEnding"
                          Background="Transparent" 
                          BorderThickness="0"
                          RowBackground="#1E1E2E"
                          AlternatingRowBackground="#252636"
                          Foreground="White"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#313244">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="50"/>
                        <DataGridTextColumn Header="Назва страви" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTextColumn Header="Категорія" Binding="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                        <DataGridTextColumn Header="Ціна (грн)" Binding="{Binding Price, StringFormat={}{0:N0} ₴, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Підвал / Панель додавання та видалення -->
        <Border Grid.Row="2" Background="#262738" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Поля введення нової страви -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,15,0">
                        <TextBlock Text="Назва:" Foreground="#A6ADC8" FontSize="11" Margin="0,0,0,3"/>
                        <TextBox x:Name="NameBox" Width="180" Height="28" VerticalContentAlignment="Center" 
                                 Background="#313244" Foreground="White" BorderThickness="0" Padding="5,0"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,15,0">
                        <TextBlock Text="Категорія:" Foreground="#A6ADC8" FontSize="11" Margin="0,0,0,3"/>
                        <TextBox x:Name="CategoryBox" Width="130" Height="28" Text="Гарячі страви" VerticalContentAlignment="Center" 
                                 Background="#313244" Foreground="White" BorderThickness="0" Padding="5,0"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Ціна (грн):" Foreground="#A6ADC8" FontSize="11" Margin="0,0,0,3"/>
                        <TextBox x:Name="PriceBox" Width="90" Height="28" VerticalContentAlignment="Center" 
                                 Background="#313244" Foreground="White" BorderThickness="0" Padding="5,0"/>
                    </StackPanel>

                    <Button Content="+ Додати страву" Width="120" Height="28" VerticalAlignment="Bottom" 
                            Background="#45475A" Foreground="White" BorderThickness="0" Click="AddButton_Click"/>
                </StackPanel>

                <!-- Кнопка видалення справа -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text=" " FontSize="11" Margin="0,0,0,3"/>
                    <!-- Для вирівнювання по висоті з полями -->
                    <Button Content="Видалити обрану" Width="130" Height="28" 
                            Background="#453134" Foreground="#F38BA8" BorderThickness="0" Click="DeleteButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
