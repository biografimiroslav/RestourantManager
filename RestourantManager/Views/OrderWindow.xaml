<Window x:Class="RestaurantManager.Views.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Замовлення" Height="600" Width="900"
        WindowStartupLocation="CenterScreen" Background="#1E1E2E" Foreground="White">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <DockPanel Grid.Row="0" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtTableTitle" Text="Стіл №1 (4 місця)" FontSize="20" FontWeight="Bold"/>
            </StackPanel>

            <Button Content="← Назад до залу" Click="BtnBack_Click"
                    Padding="12,6" Background="#313244" Foreground="White" BorderThickness="0" HorizontalAlignment="Right"/>
        </DockPanel>

        <!-- Основна зона: Меню та Чек -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#262738" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Меню" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>

                    <ListBox x:Name="LvMenuDishes" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding CategoryName}" Foreground="#A6ADC8" FontSize="11"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding Price, StringFormat={}{0:N0} ₴}"
                                               Foreground="#A6E3A1" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0"/>

                                    <Button Grid.Column="2" Content="+ Додати" Click="BtnAddDish_Click" Tag="{Binding Id}"
                                            Padding="10,5" Background="#45475A" Foreground="White" BorderThickness="0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#262738" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Замовлені страви" FontSize="15" FontWeight="Bold"/>

                    </DockPanel>



                    <ListBox x:Name="LvOrderItems" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch" SelectionChanged="LvOrderItems_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DishName}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:N0} ₴ / шт}" Foreground="#A6ADC8" FontSize="11"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                        <Button Content="-" Click="BtnMinus_Click" Tag="{Binding Id}"
                                                Width="26" Height="26" Background="#313244" Foreground="White" BorderThickness="0"/>
                                        <TextBlock Text="{Binding Quantity}" Foreground="White" FontWeight="Bold"
                                                   VerticalAlignment="Center" Margin="8,0" Width="18" TextAlignment="Center"/>
                                        <Button Content="+" Click="BtnPlus_Click" Tag="{Binding DishId}"
                                                Width="26" Height="26" Background="#313244" Foreground="White" BorderThickness="0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding TotalPrice, StringFormat={}{0:N0} ₴}"
                                               Foreground="#F9E2AF" FontWeight="Bold" VerticalAlignment="Center" Width="60" TextAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Підвал -->
        <DockPanel Grid.Row="2"  LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,10">
                <TextBlock Text="Разом до оплати: " FontSize="16" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtTotalAmount" Text="0 ₴" Foreground="#fff" FontSize="18"  VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,10">
                <Button x:Name="BtnSaveOrder" Content="Зберегти чек" Click="BtnSaveOrder_Click"
                        Padding="14,8" Margin="0,0,10,0" Background="#313244" Foreground="White" BorderThickness="0"/>
                <Button x:Name="BtnPayAndClose" Content="Оплатити та закрити стіл" Click="BtnPayAndClose_Click"
                        Padding="14,8" Background="#313244" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>